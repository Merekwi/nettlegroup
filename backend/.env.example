# Neon Function environment variable names. Put real values in the Neon Function settings only.
# Never commit secrets or a live database connection string.

TELEGRAM_BOT_TOKEN=SET_IN_NEON_FUNCTION_ENV
INITIAL_ADMIN_TELEGRAM_ID=YOUR_TELEGRAM_ID
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
SITE_ORIGIN=https://www.nettlegroup.space

# Presidential Simulator connection. These are already set on the live nettleapi deployment.
PRESIDENTIAL_DATABASE_URL=SET_IN_NEON_FUNCTION_ENV
PRESIDENTIAL_GAME_ORIGIN=https://merekwi.github.io

# Optional: enable AI-generated decree wording. Without these, the server uses the built-in legal template.
OPENROUTER_API_KEY=SET_IN_NEON_FUNCTION_ENV
OPENROUTER_MODEL=YOUR_OPENROUTER_MODEL_SLUG
