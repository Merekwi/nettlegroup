# Copy this to a private server environment file after the VPS and station exist.
# Never commit real values or place AzuraCast credentials in the Android app.

EUROMIX_RADIO_PUBLIC_URL=https://radio.example.invalid
EUROMIX_AZURACAST_API_URL=https://radio.example.invalid/api
EUROMIX_AZURACAST_STATION_SHORTCODE=euromix
EUROMIX_AZURACAST_STATION_ID=
EUROMIX_STREAM_URL=
EUROMIX_NOW_PLAYING_URL=https://radio.example.invalid/api/nowplaying/euromix

# Server-side integration only. Generate a long unique secret for the adapter.
AZURACAST_API_KEY=

# The radio-control adapter will verify Euromix mobile tokens with this same
# secret used by NettleGroup's API. Transfer it securely; never commit it.
SESSION_SECRET=

# Use the same Neon database as the existing NettleGroup identity system.
# Do not create a second user table or a separate admin list.
DATABASE_URL=
